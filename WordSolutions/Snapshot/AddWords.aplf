 r←AddWords new;exists;new_dist;WORDS;DIST
 new←⊆new
 :Hold 'INDEX'
     (WORDS DIST)←INDEX
     exists←(≢WORDS)≥WORDS⍳new
     :If ∧/exists
         r←'0 words added'
         :Return
     :EndIf
     new/⍨←~exists
     WORDS⍪←new
     new_dist←new∘.Dist WORDS
     DIST←(DIST,(≢DIST)↑⍉new_dist)⍪new_dist
     INDEX←(WORDS DIST)
 :EndHold
 r←(+/~exists)⍕⍛,' words added'
