 r←AddWords new;exists;new_dist
 new←⊆new
 :Hold 'INDEX'
     exists←(≢WORDS)≥WORDS⍳new
     :If ∧/exists
         r←'0 words added'
         :Return
     :EndIf
     new/⍨←~exists
     WORDS⍪←new
     new_dist←new∘.Dist WORDS
     DIST←(DIST,(≢DIST)↑⍉new_dist)⍪new_dist
 :EndHold
 r←(+/~exists)⍕⍛,' words added'
